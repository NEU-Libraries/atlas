# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Every variable here is read by docker-compose.yml alone, and every one has a
# working default, so an unset .env brings the whole stack up and mints. They
# exist to point a dev stack at another handle server, prefix or resolver.
#
# WARNING: .env is not a shell script. Compose does no command substitution in
# it, so a line like HANDLE_ADMIN_SECRET=$(openssl rand -hex 16) stores those
# 23 characters literally instead of a random secret. Generate the value in
# your shell and paste the result:
#
#   openssl rand -hex 16

# ---- Handle.Net minting ----
#
# Atlas mints a persistent identifier at POST /works/:id/complete and records
# "<prefix>/<noid>" on the Work. The handle server comes up with the rest of
# the stack, so a plain `docker compose up -d` mints against it.

# The prefix this dev server homes itself for. Handles mint as <prefix>/<noid>,
# and the compose file derives the handle server's admin identity from it.
#HANDLE_PREFIX=DRSDEV

# Authenticates every administrative write. One value arms both sides: the
# handle container seeds its bootstrap admin record with it, and Atlas
# authenticates against that record. Set it here and both sides move together;
# set it on one side alone and the stack looks healthy but mints nothing. The
# dev default guards a local, unregistered store — see the warning above before
# you generate a real one for anything else.
#HANDLE_ADMIN_SECRET=

# Where Atlas reaches the handle server. Writes need TLS; reads answer over
# plain HTTP on the same port.
#HANDLE_SERVER_URL=https://handle:8000

# Where a minted handle sends a reader — the public Cerberus Work page. Atlas
# does not know Cerberus's host, so it arrives as config.
#CERBERUS_PUBLIC_BASE=http://localhost:3000

# The resolver Atlas writes into the MODS `hdl` identifier, so that the stored
# value is the citable URL the field is named for. Dev names the local server:
# an unregistered prefix is in no Global Handle Registry, so hdl.handle.net
# cannot answer for it. Production leaves this unset and takes the default,
# https://hdl.handle.net.
#HANDLE_RESOLVER_BASE=http://localhost:8000
