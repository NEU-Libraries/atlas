#!/usr/bin/env bash
#
# Re-record the example bodies in spec/openapi_examples from a run of the
# request specs, then regenerate the OpenAPI documents with them.
#
#   bin/openapi-record          six workers, about six minutes
#   bin/openapi-record -n 4     four workers
#
# The old files are removed first, so an example whose operation is gone does
# not survive. Review the diff before you commit: every example is published.
# See docs/openapi.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/container.sh
source "$SCRIPT_DIR/lib/container.sh"

WORKERS=6
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) WORKERS="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

container_init
"$SCRIPT_DIR/parallel-solr-cores" "$WORKERS"

rm -rf "$REPO_ROOT/spec/openapi_examples"
docker exec -e RECORD_EXAMPLES=1 -w "$CONTAINER_ROOT" "$WEB_CONTAINER" \
  bundle exec parallel_rspec -n "$WORKERS" spec/requests

"$SCRIPT_DIR/openapi"
