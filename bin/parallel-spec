#!/usr/bin/env bash
#
# Run the whole suite sharded across worker processes.
#
#   bin/parallel-spec              # four workers
#   bin/parallel-spec -n 2         # two
#
# Each worker owns its own database, Solr core and OCFL storage root, because a
# run wipes all three at startup. The databases are created by the rake task;
# the Solr cores have to be created from the host, so this provisions them first.
# They do not survive a Solr recreate, which is why that step is idempotent and
# cheap to repeat.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/container.sh
source "$SCRIPT_DIR/lib/container.sh"

WORKERS=4

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) WORKERS="$2"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

container_init

"$SCRIPT_DIR/parallel-solr-cores" "$WORKERS"

exec docker exec -w "$CONTAINER_ROOT" "$WEB_CONTAINER" \
  bundle exec rake parallel:spec WORKERS="$WORKERS"
