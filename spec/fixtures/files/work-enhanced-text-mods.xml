        <mods:title>Origin of the high-energy kink in the superconductor Bi&lt;sub&gt;2&lt;/sub&gt;Sr&lt;sub&gt;2&lt;/sub&gt;CaCu&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</mods:title>
    </mods:titleInfo>
    <mods:abstract>Photoemission measurements of the electron self-energy, reported for E=mc&lt;sup&gt;2&lt;/sup&gt; scaling.</mods:abstract>
</mods:mods>
